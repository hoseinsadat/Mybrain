# ---- Core -------------------------------------------------------------
DATABASE_URL=postgresql://mybrain:change-me@db:5432/mybrain
POSTGRES_PASSWORD=change-me
DATA_DIR=/data
# Optional single-user password for the UI/API (Bearer or Basic). Prefer Tailscale instead.
APP_PASSWORD=
# auto | pg_search | tsvector  (auto picks pg_search when the extension exists)
LEXICAL_BACKEND=auto

# ---- Embeddings (pluggable, versioned per index_version) -------------
# gemini | voyage | openai_compat
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-2
EMBED_DIMS=1536
GEMINI_API_KEY=
VOYAGE_API_KEY=
# openai_compat works for Together (Qwen3-Embedding-8B), Fireworks, Jina, OpenAI
OPENAI_COMPAT_BASE_URL=https://api.together.xyz/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# ---- Reranker ----------------------------------------------------------
# zeroentropy | cohere | voyage | none
RERANK_PROVIDER=zeroentropy
RERANK_MODEL=zerank-2
ZEROENTROPY_API_KEY=
COHERE_API_KEY=
RETRIEVE_CANDIDATES=40
FINAL_TOP_K=10

# ---- LLMs --------------------------------------------------------------
ANTHROPIC_API_KEY=
# Final cited answer. claude-opus-5-5 (default) or claude-sonnet-5-5 for lower cost.
ANSWER_PROVIDER=anthropic
ANSWER_MODEL=claude-opus-5-5
ANSWER_EFFORT=medium
# Cheap, high-volume calls: chunk context, entity extraction, query planning.
# gemini | anthropic
EXTRACT_PROVIDER=gemini
EXTRACT_MODEL=gemini-3.8-flash
# used when EXTRACT_PROVIDER=anthropic
EXTRACT_ANTHROPIC_MODEL=claude-haiku-4-5

# ---- Parsing -----------------------------------------------------------
# auto | llamaparse | local   (auto: LlamaParse for complex/scanned PDFs when key is set, local otherwise)
PDF_PARSER=auto
LLAMAPARSE_API_KEY=
LLAMAPARSE_TIER=agentic
LLAMAPARSE_VERSION=latest
LLAMAPARSE_LANGUAGE=en
LLAMAPARSE_BASE_URL=https://api.cloud.llamaindex.ai

# ---- Ingestion ---------------------------------------------------------
CHUNK_TOKENS=400
CHUNK_OVERLAP_TOKENS=40
CONTEXTUALIZE=true
EXTRACT_ENTITIES=true
WORKER_POLL_SECONDS=2

# ---- Retrieval ---------------------------------------------------------
RRF_K=60
ENTITY_BOOST=0.5
SECOND_PASS=true
